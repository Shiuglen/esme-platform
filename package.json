{
  "name": "esme-platform",
  "type": "module",
  "version": "0.2.0",
  "description": "El runtime de la mente local: contratos, formatos, firmas, extension host y la Tienda",
  "license": "MIT",
  "keywords": [
    "esme",
    "mente-local",
    "extension-host",
    "tienda",
    "contratos"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@12.2.0",
  "main": "./dist/core/ipc/sdk.js",
  "types": "./dist/core/ipc/sdk.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/core/ipc/sdk.d.ts",
      "import": "./dist/core/ipc/sdk.js"
    },
    "./sdk": {
      "types": "./dist/core/ipc/sdk.d.ts",
      "import": "./dist/core/ipc/sdk.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js"
    },
    "./tienda/*": {
      "types": "./dist/tienda/*.d.ts",
      "import": "./dist/tienda/*.js"
    },
    "./motores/*": {
      "types": "./dist/motores/*.d.ts",
      "import": "./dist/motores/*.js"
    },
    "./modulos/nucleo/*": {
      "types": "./dist/modulos/nucleo/*.d.ts",
      "import": "./dist/modulos/nucleo/*.js"
    },
    "./estandar/*": "./estandar/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "core",
    "tienda/*.ts",
    "tienda/*.json",
    "tienda/*.pem",
    "motores",
    "estandar",
    "modulos",
    "docs",
    "README.md",
    "LICENSE",
    "LICENSE-COMMUNITY.md"
  ],
  "dependencies": {
    "js-yaml": "^5.5.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "test": "vitest run",
    "spec:lint": "tsx scripts/spec-lint.ts",
    "compat": "tsx scripts/estandar/compat-check.ts",
    "puntos": "tsx scripts/puntos.ts",
    "arbol": "tsx scripts/arbol.ts",
    "talamo": "tsx scripts/talamo.ts",
    "turno": "tsx scripts/turno.ts",
    "arena": "tsx scripts/arena.ts",
    "equipo": "tsx scripts/equipo.ts",
    "bot:check": "tsx scripts/bot-check.ts",
    "router": "tsx scripts/router.ts",
    "deseos": "tsx scripts/deseos.ts",
    "publicar:deseos": "tsx scripts/publicar-deseos.ts",
    "publicar:recursos": "tsx scripts/publicar-recursos.ts",
    "tienda:busca": "tsx scripts/tienda-busca.ts",
    "verificar:skill": "tsx scripts/verificar-skill.ts",
    "cambios": "tsx scripts/cambios.ts",
    "ejecutar": "tsx scripts/ejecutar.ts",
    "puertas": "tsx scripts/puertas.ts",
    "doctor": "tsx scripts/doctor.ts",
    "piel:check": "tsx scripts/estandar/piel-check.ts",
    "agente:check": "tsx scripts/estandar/agente-check.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:ejemplo": "tsx scripts/construir-modulos.ts modulos/ejemplo-hola-mundo modulos/ejemplo-troceo-pro modulos/ejemplo-puerta",
    "build:modulos": "tsx scripts/construir-modulos.ts --todos",
    "crear:modulo": "tsx scripts/crear-modulo.ts",
    "verificar:modulo": "tsx scripts/verificar-modulo.ts",
    "publicar:modulo": "tsx scripts/publicar-modulo.ts",
    "firma:index": "tsx scripts/firmar-index.ts",
    "mind": "tsx scripts/mind-cli.ts",
    "panel": "tsx scripts/panel.ts",
    "bench": "tsx scripts/bench.ts",
    "verificar": "tsx scripts/verificar.ts",
    "instalar": "tsx scripts/instalar.ts",
    "instalar:remoto": "tsx scripts/instalar-remoto.ts",
    "programas": "tsx scripts/programas.ts",
    "rea": "tsx scripts/rea.ts",
    "modulos": "tsx scripts/modulos.ts",
    "modulos:juzgar": "tsx scripts/juzgar-modulos.ts",
    "revocar": "tsx scripts/revocar.ts",
    "rotar": "tsx scripts/rotar.ts",
    "delegar": "tsx scripts/delegar.ts",
    "llave:release": "tsx scripts/llave-release.ts",
    "incidente": "tsx scripts/incidente.ts",
    "skills:juzgar": "tsx scripts/juzgar-skills.ts",
    "skills:publicar": "tsx scripts/publicar-veredictos.ts",
    "tienda:publicar": "tsx scripts/publicar-catalogo.ts",
    "tienda:publicar-modulos": "tsx scripts/publicar-modulos.ts",
    "tienda:permisos": "tsx scripts/tienda-permisos.ts",
    "tienda": "npm run bench && npm run verificar",
    "casa": "tsx scripts/casa.ts",
    "banco": "tsx scripts/banco.ts",
    "prueba0:real": "tsx scripts/prueba0-real.ts",
    "prueba0:rea": "tsx scripts/prueba0-rea.ts",
    "release:check": "tsx scripts/release-check.ts",
    "test:offline": "vitest run tests/offline.test.ts tests/tienda-firma.test.ts tests/redaction.test.ts tests/mind-format.test.ts tests/programas.test.ts tests/rea-real.test.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run spec:lint && npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}
