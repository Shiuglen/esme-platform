{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["core", "tienda", "motores", "modulos/nucleo"],
  "exclude": ["**/*.test.ts", "**/test/**", "node_modules", "dist"]
}
